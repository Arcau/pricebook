# Copy to .env and adjust. Keep .env private (chmod 600).
TZ=Australia/Brisbane

# Leave true when served over HTTPS (it should be). Only set false for local testing over plain HTTP.
COOKIE_SECURE=true

# Open Food Facts asks apps to identify themselves. Put your own contact here.
OFF_USER_AGENT=Pricebook/0.2 (self-hosted; contact you@example.org)

# A new price counts without proof when it is no more than this far above or below
# the product's typical price. Outside the range it is held until a receipt or a
# shelf price tag photo backs it up.
MAX_OVER_USUAL_PERCENT=50
MAX_UNDER_USUAL_PERCENT=50

# Optional: an Ollama server with a vision model reads shelf price tag photos and
# confirms a held price when the price it reads matches exactly.
# OLLAMA_URL=http://ollama.example.lan:11434
# OLLAMA_MODEL=qwen2.5vl:7b

# Optional: lets another app look prices up at /api/v1/lookup/<barcode> with this bearer token.
# LOOKUP_API_TOKEN=change-me-to-a-long-random-string

# Where users of your instance can find its source code (required by the AGPL if you change it).
# SOURCE_URL=https://github.com/you/pricebook
